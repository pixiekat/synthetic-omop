# Secrets
.env

# Everything under backups/ is not needed for the project to run. Keep the folder structure with .gitkeep files.
backups/**
!backups/**/
!backups/**/.gitkeep
*.dump

# Everything under data/ is large, licensed (Athena, NSDUH terms) or generated.
# Keep the folder structure with .gitkeep files.
data/**
!data/**/
!data/**/.gitkeep

# R / Python cruft
.Rhistory
.RData
__pycache__/
*.pyc
